# Copy this file to .env and fill in your values
# .env is in .gitignore — never commit real credentials

METABASE_URL=https://your.metabase.com

# Preferred: an API key (Admin > Settings > Authentication > API keys).
# If set, this is used and USERNAME/PASSWORD below are ignored.
METABASE_API_KEY=

# Fallback: username/password login, only used if METABASE_API_KEY is blank.
METABASE_USERNAME=you@example.com
METABASE_PASSWORD=yourpassword

# Card IDs of your saved Metabase questions
# (see SETUP.md for how to create them)
METABASE_AGG_CARD_ID=0
METABASE_SSEID_CARD_ID=0
METABASE_HELDBASE_CARD_ID=0
METABASE_COHORT_CARD_ID=0

# How many months back to fetch (3, 6, 9, or 12)
MONTHS=6

# Override end month — leave blank to use the last FULLY COMPLETED month
# (the dashboard never reports on a month still in progress; that partial
# data shows separately as the month-to-date indicator instead).
# Format: YYYY-MM  e.g. 2026-04
END_MONTH=
