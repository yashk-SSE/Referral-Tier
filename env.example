# Copy this file to .env and fill in your values
# .env is in .gitignore — never commit real credentials

METABASE_URL=https://your.metabase.com
METABASE_USERNAME=you@example.com
METABASE_PASSWORD=yourpassword

# Card IDs of your two saved Metabase questions
# (see SETUP.md for how to create them)
METABASE_AGG_CARD_ID=0
METABASE_SSEID_CARD_ID=0

# How many months back to fetch (3, 6, 9, or 12)
MONTHS=6

# Override end month — leave blank to use current month
# Format: YYYY-MM  e.g. 2026-04
END_MONTH=
